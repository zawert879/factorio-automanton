{
  "name": "automaton",
  "private": true,
  "description": "Factorio mod: programmable automatons instead of belts, drills and inserters",
  "scripts": {
    "build": "tstl",
    "watch": "tstl --watch",
    "test": "node tools/test/run.mjs",
    "test:game": "node tools/test/game.mjs",
    "test:desync": "node tools/test/desync.mjs",
    "shot": "node tools/visual/shot.mjs",
    "bench:lang": "node tools/test/run.mjs --build-only && tools/lua/5.2/bin/lua tools/bench/lang.lua build",
    "bench:game": "node tools/bench/game.mjs",
    "prebuild": "node tools/dts/generate.mjs",
    "dts": "node tools/dts/generate.mjs --check",
    "test:sync": "node tools/test/sync.mjs",
    "bench:flyers": "node tools/bench/flyers.mjs",
    "test:desync:heavy": "node tools/test/desync.mjs --heavy",
    "test:mp": "node tools/test/mp.mjs",
    "bench:machines": "node tools/bench/machines.mjs",
    "package": "cd mod && npx --yes factoriomod-debug@2.0.14 package && mkdir -p ../dist && mv automaton_*.zip ../dist/",
    "demo:science": "node tools/demo/science.mjs",
    "docs:record": "node tools/docs/record.mjs",
    "bench:scale": "node tools/bench/scale.mjs"
  },
  "devDependencies": {
    "gifenc": "^1.0.3",
    "lua-types": "2.14.1",
    "pngjs": "^7.0.0",
    "typed-factorio": "3.36.0",
    "typescript": "6.0.2",
    "typescript-to-lua": "1.37.1"
  }
}
